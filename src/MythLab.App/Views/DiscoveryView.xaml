<UserControl x:Class="MythLab.App.Views.DiscoveryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="8">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Discover your network" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock Text="Find devices on your LAN, then choose which ones to manage." Opacity=".65" Margin="0,8,0,16"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Local IPv4 interface"/>
    <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" DisplayMemberPath="DisplayLabel"
     IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Discovery interface" MinWidth="280"/>
   </StackPanel>
   <Button Grid.Column="1" Content="_Refresh interfaces" Command="{Binding RefreshInterfacesCommand}" VerticalAlignment="Center" Margin="12,12,0,0"/>
  </Grid>
  <Grid Grid.Row="2" Margin="0,4,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="Start IPv4"/><TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Scan start address"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="End IPv4"/><TextBox Text="{Binding EndAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Scan end address"/></StackPanel>
   <Button Grid.Column="2" Content="_Scan" Command="{Binding ScanCommand}" VerticalAlignment="Center"/>
   <Button Grid.Column="3" Content="_Cancel scan" Command="{Binding ScanCancelCommand}" VerticalAlignment="Center" Margin="0"/>
  </Grid>
  <StackPanel Grid.Row="3">
   <ProgressBar Value="{Binding Completed}" Maximum="{Binding Total}" Height="5" Margin="0,0,0,10"
    AutomationProperties.Name="Discovery progress"/>
   <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding Diagnostic}" Margin="0,4,0,0"/>
   <TextBlock Text="Online = ping reply or this computer. Scan read time is not when a cached device was last alive. Discovery cannot determine Wake-on-LAN support." FontSize="12" Opacity=".65" Margin="0,8,0,12"/>
  </StackPanel>
  <DataGrid Grid.Row="4" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
   AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
   SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="42"
   EnableRowVirtualization="True" CanUserSortColumns="False" AutomationProperties.Name="Discovered devices">
   <DataGrid.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
     <Setter Property="TextWrapping" Value="NoWrap"/>
     <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
     <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
   </DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="IPv4 address" Binding="{Binding Device.Address}" Width="125"/>
    <DataGridTextColumn Header="Hostname" Binding="{Binding Device.Hostname}" Width="150"/>
    <DataGridTextColumn Header="MAC address" Binding="{Binding Device.MacAddress}" Width="155"/>
    <DataGridTextColumn Header="State" Binding="{Binding Device.StateLabel}" Width="100"/>
    <DataGridTextColumn Header="Inventory" Binding="{Binding ManagedLabel}" Width="200"/>
    <DataGridTextColumn Header="Evidence" Binding="{Binding Device.Evidence}" Width="170"/>
    <DataGridTextColumn Header="Scan read" Binding="{Binding Device.EvidenceCollectedAt, StringFormat=HH:mm:ss}" Width="85"/>
    <DataGridTextColumn Header="Vendor (if known)" Binding="{Binding Device.Vendor}" Width="140"/>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="5" Margin="0,16,0,0">
   <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center"/>
   <Button Content="_Add to My Devices" Command="{Binding AddSelectedCommand}" HorizontalAlignment="Right" Margin="0"/>
  </DockPanel>
 </Grid>
</UserControl>
