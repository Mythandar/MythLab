<Window x:Class="RemoteManager.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:RemoteManager.App.Views"
 Title="{Binding DisplayName}" Width="1180" Height="800" MinWidth="920" MinHeight="640"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,24">
   <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Your homelab" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity=".65"/>
  </DockPanel>
  <TabControl Grid.Row="1" TabStripPlacement="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0" Padding="24,0,0,0">
   <TabControl.Resources>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
     <Setter Property="Padding" Value="18,14"/>
     <Setter Property="MinWidth" Value="170"/>
     <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
   </TabControl.Resources>
   <TabItem Header="My Devices"><views:DevicesView/></TabItem>
   <TabItem Header="Discovery">
    <StackPanel Margin="8">
     <TextBlock Text="Discover your network" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Coming in Milestone B" Margin="0,12,0,20" Opacity=".65"/>
     <TextBlock Text="Scan a selected local IPv4 network, review discovered devices, and add the ones you want to manage." MaxWidth="640" HorizontalAlignment="Left"/>
     <TextBlock Text="Discovery will combine neighbor information, ARP and ping. Devices that do not answer ping may still appear." Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Connections / Credentials">
    <StackPanel Margin="8">
     <TextBlock Text="Connections &amp; credentials" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Coming in Milestones D and E" Margin="0,12,0,20" Opacity=".65"/>
     <TextBlock Text="Each device can have multiple SSH, RealVNC, Moonlight, web and custom connections." MaxWidth="640" HorizontalAlignment="Left"/>
     <TextBlock Text="Reusable credentials will be saved securely by Windows. This version does not collect or save passwords." Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
    </StackPanel>
   </TabItem>
   <TabItem Header="Settings"><views:SettingsView/></TabItem>
   <TabItem Header="Diagnostics">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="Diagnostics" FontSize="28" FontWeight="SemiBold"/>
     <StackPanel Grid.Row="1" Margin="0,16,0,16">
      <TextBlock Text="Recent events from this session. Rolling JSON logs are stored in the logs folder." Margin="0,0,0,12"/>
      <Button Content="_Refresh events" Command="{Binding RefreshDiagnosticsCommand}" HorizontalAlignment="Left"/>
     </StackPanel>
     <TextBox Grid.Row="2" Text="{Binding Diagnostics, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
      TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Diagnostic events"/>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Margin="0,20,0,0" Padding="8" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/>
  </Border>
 </Grid>
</Window>
