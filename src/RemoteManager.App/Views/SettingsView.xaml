<UserControl x:Class="RemoteManager.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="8" MaxWidth="620" HorizontalAlignment="Left">
   <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <TextBlock Text="Appearance"/>
   <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Theme"/>
   <TextBlock Text="Appearance changes preview immediately. Save settings to keep your preference." Opacity=".65" Margin="0,0,0,8"/>
   <TextBlock Text="Network defaults" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,6"/>
   <TextBlock Text="Discovery uses these values on its next scan. Status polling will be used when monitoring is available." Margin="0,0,0,16" Opacity=".65"/>
   <TextBlock Text="Status polling interval (seconds, 5–3600)"/>
   <TextBox Text="{Binding PollingInterval, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Polling interval"/>
   <TextBlock Text="Discovery concurrency (1–64)"/>
   <TextBox Text="{Binding DiscoveryConcurrency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Discovery concurrency"/>
   <TextBlock Text="Probe timeout (milliseconds, 100–10000)"/>
   <TextBox Text="{Binding ProbeTimeout, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Probe timeout"/>
   <Button Content="_Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,6,0,24"/>
   <TextBlock Text="Portable application data" FontSize="18" FontWeight="SemiBold"/>
   <TextBox Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Application data directory"/>
   <TextBlock Text="This Data folder moves with the executable. Close the app before copying it. inventory.db stores devices. settings.json stores preferences. The logs folder retains up to seven rolling log files." Opacity=".65"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
