<UserControl x:Class="RemoteManager.App.Views.DevicesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:RemoteManager.App.Views">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel><TextBlock Text="My Devices" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding InventorySummary}" Margin="0,6,0,0" Opacity=".65"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="_Check now" Command="{Binding Activity.CheckNowCommand}"/>
    <Button Content="_Reload" Command="{Binding RefreshCommand}"/>
    <Button Content="_Add device" Command="{Binding AddCommand}"/>
   </StackPanel>
  </DockPanel>
  <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,20,8,12"
   AutomationProperties.Name="Search devices" ToolTip="Search name, hostname, IP, MAC, group or tags"/>
  <TextBlock Grid.Row="2" Text="Status uses the configured ICMP or TCP check. Wake waits for that check to succeed." Opacity=".65" Margin="0,0,0,16"/>
  <Grid Grid.Row="3">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="Your devices, in one place" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="Add your first computer or server to build your inventory." Margin="0,10,0,18" HorizontalAlignment="Center"/>
    <Button Content="Add your _first device" Command="{Binding AddCommand}" HorizontalAlignment="Center"/>
   </StackPanel>
   <ListBox ItemsSource="{Binding FilteredDevices}" Background="Transparent" BorderThickness="0" Padding="0"
    HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
    AutomationProperties.Name="Managed devices">
    <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
    <ListBox.ItemsPanel><ItemsPanelTemplate><views:ResponsiveCardsPanel MinimumColumnWidth="340"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle>
     <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
     </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="18">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
        <StackPanel Grid.Row="1" Margin="0,6,0,0">
         <TextBlock Text="{Binding Endpoint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Endpoint}"/>
         <TextBlock Text="{Binding IPv4Address}" Opacity=".65"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
         <TextBlock Text="{Binding Type}" Opacity=".65" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding Group}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="38"/>
        </WrapPanel>
        <TextBlock Grid.Row="3" Text="{Binding Notes}" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,6,0,10" Opacity=".65" ToolTip="{Binding Notes}"/>
        <StackPanel Grid.Row="4">
         <DockPanel Margin="0,0,0,12">
          <TextBlock Text="{Binding State, StringFormat='●  {0}'}" FontWeight="SemiBold" ToolTip="{Binding Detail}"/>
          <TextBlock Text="{Binding Wake.Capability, StringFormat='WoL: {0}'}" FontSize="12" Opacity=".65" HorizontalAlignment="Right"/>
         </DockPanel>
         <TextBlock Text="{Binding Detail}" FontSize="12" MaxHeight="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock Text="{Binding LastSeen}" FontSize="12" Opacity=".65" Margin="0,0,0,8"/>
         <WrapPanel>
          <Button Content="_Wake" Command="{Binding DataContext.Activity.WakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWake}" Visibility="{Binding WakeEnabled, Converter={StaticResource BoolVisibility}}"/>
          <Button Content="Test Wake" Command="{Binding DataContext.Activity.TestWakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWake}" Visibility="{Binding WakeEnabled, Converter={StaticResource BoolVisibility}}" ToolTip="Checks availability, sends wake packets and watches for an Offline to Online transition."/>
          <Button Content="Cancel wake" Command="{Binding DataContext.Activity.CancelWakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Visibility="{Binding IsWaking, Converter={StaticResource BoolVisibility}}"/>
          <Button Content="_Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          <Button Content="_Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         </WrapPanel>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Grid>
 </Grid>
</UserControl>
