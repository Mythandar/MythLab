<Window x:Class="RemoteManager.App.Views.DeviceEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Title}" Width="700" Height="820" MinWidth="600" MinHeight="540"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="0,0,16,0">
    <TextBlock Text="Friendly name *"/>
    <TextBox x:Name="NameInput" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Friendly name"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Hostname"/><TextBox Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hostname"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="IPv4 address"/><TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="IPv4 address"/></StackPanel>
    </Grid>
    <TextBlock Text="Supply at least a hostname or IPv4 address. Addresses can be changed later." Opacity=".65" Margin="0,0,0,12"/>
    <TextBlock Text="MAC address"/>
    <TextBox Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="MAC address"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Device type"/><ComboBox ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding DeviceType}" AutomationProperties.Name="Device type"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Group / category"/><TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Group"/></StackPanel>
    </Grid>
    <TextBlock Text="Tags (comma separated)"/>
    <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tags"/>
    <TextBlock Text="Notes"/>
    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" MaxLength="10000" AutomationProperties.Name="Notes"/>
    <Expander Header="Wake-on-LAN configuration" IsExpanded="True" Margin="0,8,0,12">
     <StackPanel Margin="0,12,0,0">
      <CheckBox Content="Enable Wake-on-LAN (unverified)" IsChecked="{Binding WakeEnabled}" Margin="0,0,0,10"/>
      <TextBlock Text="Discovery cannot prove wake support. Test Wake verifies an observed Offline to Online transition after sending. Configure BIOS and NIC wake support on the target." Opacity=".65" Margin="0,0,0,12"/>
      <TextBlock Text="Broadcast address (blank = automatic)"/>
      <TextBox Text="{Binding BroadcastAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Broadcast address"/>
      <TextBlock Text="Preferred network interface"/>
      <ComboBox ItemsSource="{Binding Interfaces}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding InterfaceId}" AutomationProperties.Name="Preferred interface"/>
      <TextBlock Text="{Binding InterfaceNotice}" Opacity=".65"/>
      <TextBlock Text="Use a local subnet broadcast or 255.255.255.255. Multiple matching adapters require an explicit selection." Opacity=".65" Margin="0,0,0,8"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0"><TextBlock Text="UDP port"/><TextBox Text="{Binding WakePort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wake port"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Packets"/><TextBox Text="{Binding PacketCount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Packet count"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Retries"/><TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Retry count"/></StackPanel>
       <StackPanel Grid.Column="3"><TextBlock Text="Delay (ms)"/><TextBox Text="{Binding DelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wake delay"/></StackPanel>
      </Grid>
      <TextBlock Text="Retry delay (milliseconds, 50–30000)"/>
      <TextBox Text="{Binding RetryDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Wake retry delay"/>
     </StackPanel>
    </Expander>
    <Expander Header="Status check configuration">
     <StackPanel Margin="0,12,0,0">
      <TextBlock Text="Choose ICMP or an expected running TCP service. Hostnames are resolved again each check." Opacity=".65" Margin="0,0,0,10"/>
      <ComboBox ItemsSource="{Binding StatusChecks}" SelectedItem="{Binding StatusCheck}" AutomationProperties.Name="Status check"/>
      <TextBlock Text="TCP port (used only for TCP checks)"/>
      <TextBox Text="{Binding StatusPort, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Status TCP port"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
   Margin="0,12,0,12" AutomationProperties.LiveSetting="Assertive"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="_Cancel" IsCancel="True"/>
   <Button Content="_Save device" IsDefault="True" Command="{Binding SaveCommand}"/>
  </StackPanel>
 </Grid>
</Window>
